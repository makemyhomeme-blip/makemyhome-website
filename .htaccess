# MultiViews servira /faq isto sto i /faq.html -> dva URL-a za istu stranicu.
# Gasimo ga da bi postojala samo jedna verzija svakog URL-a.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

DirectoryIndex index.html index.php
ErrorDocument 404 /404.php

# 301 redirects: stare WordPress stranice → nove HTML stranice
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
# NAPOMENA: hosting na nivou servera već 301-redirectuje sve */feed/ adrese na početnu
# (prije .htaccess) — zato feed pravila ovdje pokrivaju samo root /feed/

# Force HTTPS i non-www (canonical URL) — bez ovoga Google tretira http://www. kao duplikat
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://makemyhome.me%{REQUEST_URI} [R=301,L]

# Link kopiran iz poruke/mejla cesto pokupi tacku ili zarez na kraju
# (npr. .../montaza.html.) — ocisti i preusmjeri umjesto da bacas 404.
RewriteCond %{REQUEST_URI} ^(/[^?]*\.html)[.,;:!)\]]+$
RewriteRule ^ %1 [R=301,L]

# Stari WordPress feed URL-ovi → 301 na odgovarajuću stranicu (čisti GSC 404 izvještaj)
# (product/slug/feed obrađuje 404.php koji zna da nađe pravi proizvod)
RewriteRule ^feed/?$ /? [R=301,L]
RewriteRule ^comments/feed/?$ /? [R=301,L]

# Stari WordPress sistemski fajlovi → 410 Gone (najjači signal Googleu: trajno obrisano, izbaci iz indeksa)
# Ostaci starog WordPress sajta — vracaju 410 Gone da ih Google brzo izbaci iz indeksa.
# Fajlovi ostaju na disku, samo nisu dostupni preko weba.
# index.php je stari WP front koji trazi wp-blog-header.php (ne postoji) i vracao je 500.
RewriteRule ^index\.php$ - [G,L]
RewriteRule ^index\.html_$ - [G,L]
RewriteRule ^index_override\.php$ - [G,L]
RewriteRule ^wp-.*\.php$ - [G,L]
RewriteRule ^readme\.html$ - [G,L]
RewriteRule ^license\.txt$ - [G,L]
RewriteRule ^wp-includes/ - [G,L]
RewriteRule ^wp-content/ - [G,L]
RewriteRule ^wp-admin/ - [G,L]
RewriteRule ^wp-json - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^(?!product/)(.*/)?feed/?$ /? [R=301,L]
RewriteRule ^comments/ - [G,L]

# index.html → homepage (bez ovoga Google vidi index.html kao posebnu stranicu)
RewriteRule ^index\.html$ /? [R=301,L]

# Stare WordPress /product-category/ URL-ovi (WooCommerce) → products
RewriteRule ^product-category/.*$ /products.html? [R=301,L]

# Stari WordPress/WooCommerce query parametri koji renderuju homepage kao duplikat
# PAŽNJA: cat= i category= su naši parametri — NE smiju biti u ovom redirectu
RewriteCond %{QUERY_STRING} (^|&)(p|s|author|attachment_id|wc-ajax|product-page|add-to-cart|paged)=
RewriteRule .* /? [R=301,L]

# Stare WordPress kategorije → products (? na kraju čisti stare ?add-to-cart= parametre)
RewriteRule ^proizvodi/?$ /products.html? [R=301,L]
RewriteRule ^decor-paneli/?$ /products.html? [R=301,L]
RewriteRule ^paneli/?$ /products.html? [R=301,L]
RewriteRule ^shop/?$ /products.html? [R=301,L]
RewriteRule ^prodavnica/?$ /products.html? [R=301,L]
RewriteRule ^dekorativni-zidni-paneli/?$ /products.html? [R=301,L]
RewriteRule ^aku-paneli/?$ /products.html?category=akusticni-paneli [R=301,L]
RewriteRule ^bambus-paneli/?$ /products.html?category=bambus-paneli [R=301,L]
RewriteRule ^pu-stone/?$ /products.html? [R=301,L]
RewriteRule ^uv-paneli/?$ /products.html? [R=301,L]
RewriteRule ^flex-stone/?$ /products.html?category=flex-stone [R=301,L]

# Stare WordPress info stranice → nove stranice
RewriteRule ^kontakt/?$ /contact.html? [R=301,L]
RewriteRule ^o-nama/?$ /about.html? [R=301,L]
RewriteRule ^onama/?$ /about.html? [R=301,L]
RewriteRule ^galerija/?$ /products.html? [R=301,L]
RewriteRule ^usluge/?$ /products.html? [R=301,L]
RewriteRule ^cjenovnik/?$ /cjenovnik.html? [R=301,L]
RewriteRule ^cenovnik/?$ /cjenovnik.html? [R=301,L]
RewriteRule ^cijene/?$ /cjenovnik.html? [R=301,L]
RewriteRule ^montaza/?$ /montaza.html? [R=301,L]
RewriteRule ^montaža/?$ /montaza.html? [R=301,L]
RewriteRule ^blog/?$ /? [R=301,L]
RewriteRule ^3d-letvice/?$ /products.html?category=3d-letvice [R=301,L]
RewriteRule ^akusticni-paneli/?$ /products.html?category=akusticni-paneli [R=301,L]

# /index i /index/ -> pocetna (bez ovoga /index vraca 500 zbog MultiViews-a)
RewriteRule ^index/?$ /? [R=301,L]

# URL bez ekstenzije -> .html verzija (301).
# Hosting ima ukljucen MultiViews pa je /faq servirao ISTI sadrzaj kao /faq.html —
# dva URL-a za istu stranicu, sto Google prijavljuje kao "Alternate page with canonical".
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/?$ /$1.html [R=301,L]

RewriteRule ^cjenovnik\.html$ cjenovnik.php [QSA,L]
RewriteRule ^product\.html$ product.php [QSA,L]
RewriteRule ^products\.html$ products.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers — zaštita od clickjacking, MIME sniffing, forsiranje HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # HTML i JSON - uvijek svježe (sadržaj se mijenja)
  <FilesMatch "\.(html|htm|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # CSS i JS - cache 1 godina (fajlovi su verzionisani: style-v5.css)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Slike - cache 30 dana
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Fontovi - cache 1 godina (imena su hesirana, nikad se ne mijenjaju)
  <FilesMatch "\.(woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # Dodatna zastita
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Kompresija za brže učitavanje
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
