# Data files managed via admin panel - NEVER overwrite from git
data/products.json
data/categories.json
data/inquiries.json
data/*.backup-*.json
# Slajdovi na pocetnoj: vlasnik ih mijenja kroz admin (admin/actions.php ih
# upisuje). Nisu u sync listi pa se ne mogu prepisati, ali stoje i ovdje da
# se ta greska ne moze napraviti kasnije.
data/hero-slides.json
# Kes sitemapa — pravi ga server, ne drzi se u gitu
data/sitemap-kes.xml
data/sitemap-kes.xml.tmp

# Uploads managed on server
images/categories/
images/products/

# System files
.DS_Store
Thumbs.db

# Kes dimenzija slika — pravi ga server pri prvom otvaranju stranice,
# razlikuje se lokalno i na serveru, i ne deployuje se.
data/dimenzije-slika.json

# Snimci stanja sajta (alat/snimak.py) — radna evidencija, ne ide na server.
alat/snimci/

# Python kes — nastaje otkad alat/provjera.py uvozi alat/ikone.py radi
# provjere ikona (pravilo C6). Pravi ga sam Python, vezan je za verziju
# interpretera i nema ga sta biti u repou.
__pycache__/
*.pyc
